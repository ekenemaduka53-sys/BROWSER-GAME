{
  "name": "slither-garden-server",
  "version": "1.0.0",
  "private": true,
  "description": "Socket.IO live leaderboard server for Slither Garden",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
