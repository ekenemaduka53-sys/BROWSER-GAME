# Environment variables for the leaderboard server (set them in the Render dashboard).

# Port to listen on. Render sets this automatically; locally it defaults to 4000.
PORT=4000

# Website(s) allowed to connect, comma-separated, e.g. https://slither-garden.vercel.app
# Leave unset to allow any origin (fine for local development).
CLIENT_ORIGIN=http://localhost:3000
